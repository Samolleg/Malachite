<Window x:Class="QuestStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuestStudio" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Малахит · Мастерская квестов" Width="1540" Height="980" MinWidth="1100" MinHeight="740" Background="#151A1C" Foreground="#DEE7E2" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1B2522"/>
  <SolidColorBrush x:Key="Panel" Color="#1B2224"/><SolidColorBrush x:Key="Line" Color="#303C3C"/><SolidColorBrush x:Key="Green" Color="#5FCEA0"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D7E3DD"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#94A9A0"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#DCE8E1"/><Setter Property="Background" Value="#26332F"/><Setter Property="BorderBrush" Value="#3B5047"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,7,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#335B48"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#90E8BB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#141B1C"/><Setter Property="Foreground" Value="#DDE9E2"/><Setter Property="CaretBrush" Value="#80E9B5"/><Setter Property="SelectionBrush" Value="#3C785C"/><Setter Property="BorderBrush" Value="#364640"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#DCE7E0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem"><Setter Property="ToolTip" Value="Описание"/><Setter Property="ToolTipService.InitialShowDelay" Value="450"/><Setter Property="ToolTipService.ShowDuration" Value="60000"/><EventSetter Event="ToolTipOpening" Handler="ItemTip_Opening"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#284B3D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#4C7963"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#1D3027"/><Setter Property="Foreground" Value="#E1EBE4"/><Setter Property="BorderBrush" Value="#5A9778"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15"/><Setter Property="MaxWidth" Value="590"/><Setter Property="MaxHeight" Value="650"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="Background" Value="#1B2522"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton x:Name="Less" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#557064" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="More" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Less" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="More" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid x:Name="WindowSurface" Background="#151A1C"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="CaptionBar" Background="#16261E" BorderBrush="#365342" BorderThickness="0,0,0,1" MouseRightButtonUp="Caption_Menu"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="◇" Foreground="#80D2A5" FontSize="19" Margin="0,0,9,0"/><TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#BDD3C5" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button x:Name="MinimizeButton" Content="—" Width="46" Height="31" Margin="0" Padding="0" BorderThickness="0" Background="Transparent" Click="Minimize_Click" ToolTip="Свернуть"/><Button x:Name="MaximizeButton" Content="□" Width="46" Height="31" Margin="0" Padding="0" BorderThickness="0" Background="Transparent" Click="Maximize_Click" ToolTip="Развернуть / восстановить"/><Button x:Name="CloseButton" Content="✕" Width="46" Height="31" Margin="0" Padding="0" BorderThickness="0" Background="Transparent" Click="Close_Click" ToolTip="Закрыть"/></StackPanel></Grid></Border>
 <Grid Grid.Row="1" x:Name="Surface" Background="#151A1C" TextOptions.TextFormattingMode="Display" SizeChanged="Surface_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Background="#192220" BorderBrush="#344B40" BorderThickness="0,0,0,1" Padding="23,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#244B3B" BorderBrush="#62B68B" BorderThickness="1" CornerRadius="11" Width="43" Height="43"><TextBlock Text="◇" FontSize="32" Foreground="#85E0AD" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="М А Л А Х И Т" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="МАСТЕРСКАЯ КВЕСТОВ" Foreground="#8EAC9B" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
    <TextBlock x:Name="Tagline" Grid.Column="1" Text="Код. Связи. История." Foreground="#829C8C" VerticalAlignment="Center" FontSize="14"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Открыть…" Click="Open_Click" ToolTip="MOB, текст или проект · Ctrl+O"/><Button Content="Папка MOB…" Click="Folder_Click"/><Button Content="Сохранить проект" Click="Save_Click" ToolTip="Новый файл .malachite · Ctrl+S"/><Button Content="Экспорт…" Click="Export_Click" Background="#367556" BorderBrush="#599978"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="236" MinWidth="195"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="440"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="InspectorColumn" Width="325" MinWidth="265"/></Grid.ColumnDefinitions>
   <Border Background="#1A2223" BorderBrush="#2B3735" BorderThickness="0,0,1,0" Padding="15,20,12,12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="ОБОЗРЕВАТЕЛЬ" Foreground="#8EAB9C" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="ProjectName" Text="Учебная цепочка" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,13"/></StackPanel>
     <TextBox Grid.Row="1" x:Name="SearchBox" ToolTip="Поиск скриптов, команд и GS-переменных" TextChanged="Search_Changed" Margin="0,0,0,10"/>
     <WrapPanel Grid.Row="2" Margin="0,0,0,9"><Button Content="Этапы" Click="Scripts_Click" Padding="8,6"/><Button Content="Функции" Click="Functions_Click" Padding="8,6"/><Button Content="GS" Click="Flags_Click" Padding="8,6"/></WrapPanel>
     <ListBox Grid.Row="3" x:Name="Navigation" SelectionChanged="Navigation_Changed"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="12"/><TextBlock Text="{Binding Subtitle}" Foreground="#90A69A" FontSize="10" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <StackPanel Grid.Row="4" Margin="0,14,0,0"><Button Content="＋  Добавить этап" Click="AddStage_Click" Margin="0,0,0,9"/><Button Content="Новая цепочка" Click="New_Click" Background="#202D29" Margin="0,0,0,10"/><TextBlock Text="Локальная мастерская · 0.3.1 · наведите мышь на имя" Style="{StaticResource Muted}"/></StackPanel>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#25312D"/>
   <Grid Grid.Column="2" Margin="18,19,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="GraphRow" Height="290" MinHeight="0"/><RowDefinition Height="5"/><RowDefinition Height="*" MinHeight="130"/><RowDefinition Height="Auto"/><RowDefinition Height="123"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DocumentTitle" Text="Потерянное письмо" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="DocumentSummary" Text="Учебный сценарий" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Схема + код" Click="Mixed_Click" Padding="9,6"/><Button Content="Код" Click="Code_Click" Padding="9,6"/></StackPanel></Grid>
    <Border Grid.Row="1" Background="#182220" BorderBrush="#30463A" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="14,0"><TextBlock Text="СВЯЗИ ВЫБРАННОГО ЭТАПА" Foreground="#8DAA99" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="→ запуск Script" HorizontalAlignment="Right" Foreground="#67C89C" FontSize="11" VerticalAlignment="Center"/></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="GraphCanvas" Width="700" Height="250"/></ScrollViewer></Grid></Border>
    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
    <Border Grid.Row="3" Background="#141A1C" BorderBrush="#303C3C" BorderThickness="1" CornerRadius="7" Margin="0,10,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="12,0"><TextBlock Text="ИСХОДНЫЙ КОД" FontSize="10" Foreground="#8FA99D" VerticalAlignment="Center"/><TextBlock x:Name="CaretLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#72BD97" FontSize="11"/></Grid><AdornerDecorator Grid.Row="1"><TextBox x:Name="CodeEditor" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="15,8,15,20" TextChanged="Code_Changed" SelectionChanged="Caret_Changed" SpellCheck.IsEnabled="False" TextWrapping="NoWrap" UndoLimit="100"/></AdornerDecorator></Grid></Border>
    <Grid Grid.Row="4" Margin="0,14,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CheckSummary" Text="ЛОКАЛЬНАЯ ПРОВЕРКА" Foreground="#97AFA1" FontSize="10" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Проверить · F5" Click="Check_Click" Padding="9,5"/></Grid>
    <ListBox Grid.Row="5" x:Name="Diagnostics" SelectionChanged="Diagnostic_Changed" FontSize="11"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="11"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#25312D"/>
   <Border Grid.Column="4" Background="#1B2423" BorderBrush="#303E37" BorderThickness="1,0,0,0" Padding="18,22,18,14">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="ИНСПЕКТОР" Foreground="#8EAB9B" FontSize="10"/><TextBlock x:Name="InspectorTitle" Text="Этап цепочки" FontSize="20" FontWeight="SemiBold" Margin="0,11,0,7"/><TextBlock x:Name="InspectorHint" Text="Выберите этап или функцию." Style="{StaticResource Muted}" Margin="0,0,0,17"/>
     <StackPanel x:Name="CardPanel">
      <TextBlock Text="УСЛОВИЯ ЗАПУСКА" Foreground="#7EC8A4" FontSize="10" Margin="0,0,0,7"/><TextBox x:Name="ConditionBox" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78" MaxHeight="185" VerticalScrollBarVisibility="Auto" TextChanged="Card_Changed"/>
      <TextBlock Text="ДЕЙСТВИЯ · THEN" Foreground="#7EC8A4" FontSize="10" Margin="0,17,0,7"/><TextBox x:Name="ActionBox" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="260" VerticalScrollBarVisibility="Auto" TextChanged="Card_Changed"/>
      <StackPanel x:Name="ElsePanel"><CheckBox x:Name="UseElse" Content="Использовать else" Foreground="#C9AC77" Margin="0,12,0,0" Checked="Else_Changed" Unchecked="Else_Changed" ToolTip="Добавляет или удаляет else, включая пустую ветку. Условие выбирает одну ветку при достижении."/><TextBlock Text="ИНАЧЕ · ELSE" Foreground="#C9AC77" FontSize="10" Margin="0,17,0,7"/><TextBox x:Name="ElseBox" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160" VerticalScrollBarVisibility="Auto" TextChanged="Card_Changed"/></StackPanel>
      <Button x:Name="ApplyCardButton" Content="Применить карточку к коду" Click="ApplyCard_Click" Margin="0,12,0,0" Background="#326C50"/>
      <TextBlock Text="ЗАПУСТИТЬ ДРУГОЙ SCRIPT" Foreground="#7EC8A4" FontSize="10" Margin="0,20,0,7"/>
      <ListBox x:Name="LinkTargets" Height="85" BorderBrush="#394F43" BorderThickness="1" Padding="3" FontSize="12"/>
      <Button Content="＋ Добавить вызов" Click="Link_Click" Margin="0,9,0,0"/><TextBlock Text="Вызов запускает экземпляр, а не ждёт завершения этапа." Style="{StaticResource Muted}" Margin="0,9,0,0"/>
     </StackPanel>
     <StackPanel x:Name="HelpPanel" Visibility="Collapsed"><Border Background="#16211D" BorderBrush="#35543F" BorderThickness="1" CornerRadius="6" Padding="12"><TextBlock x:Name="SignatureText" FontFamily="Consolas" FontSize="13" Foreground="#83D8AA"/></Border><TextBlock x:Name="HelpText" Margin="0,17,0,0" LineHeight="21"/><TextBlock x:Name="HelpProvenance" Foreground="#9FB29F" FontSize="11" Margin="0,18,0,12"/><TextBlock Text="ИСПОЛЬЗОВАНИЯ В ДОКУМЕНТЕ" Foreground="#7EC8A4" FontSize="10"/><ListBox x:Name="UsageList" MaxHeight="230" SelectionChanged="Usage_Changed" Margin="0,10,0,0"/></StackPanel>
     <Border BorderBrush="#34453B" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,15,0,0"><TextBlock Text="Проверка здесь — статическая. Компиляция движком и проверка в игре выполняются отдельно." Style="{StaticResource Muted}"/></Border>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#20352B" Padding="16,0"><Grid><TextBlock x:Name="StatusText" Text="Готово" FontSize="11" VerticalAlignment="Center" Foreground="#C3D8C9"/><TextBlock x:Name="EncodingText" Text="UTF-8 · локальный проект" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#95BDA4"/></Grid></Border>
 </Grid>
 </Grid>
</Window>

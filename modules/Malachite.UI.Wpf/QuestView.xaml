<UserControl x:Class="QuestStudio.QuestView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuestStudio" Background="#131513" Foreground="#EEF1EC" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources>
  <Style x:Key="CopiesMenu" TargetType="ContextMenu"><Setter Property="Foreground" Value="#EEF1EC"/><Setter Property="Background" Value="#1B1E1C"/><Setter Property="BorderBrush" Value="#465048"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5"><StackPanel IsItemsHost="True"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CopiesItem" TargetType="MenuItem"><Setter Property="Foreground" Value="#EEF1EC"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="14,11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuChrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuChrome" Property="Background" Value="#233A2C"/><Setter Property="Foreground" Value="#EEF1EC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuChrome" Property="Background" Value="#233A2C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#AAB2AA"/><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1B1E1C"/>
  <SolidColorBrush x:Key="Panel" Color="#1B1E1C"/><SolidColorBrush x:Key="Line" Color="#303632"/><SolidColorBrush x:Key="Green" Color="#39B86E"/>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#EEF1EC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton Foreground="#EEF1EC" HorizontalContentAlignment="Left" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="HeaderChrome" Background="Transparent" Padding="4,7"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Arrow" Text="▸" Foreground="#39B86E" Margin="0,0,8,0"/><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="▾"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="#233A2C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF1EC"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#AAB2AA"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Foreground" Value="#EEF1EC"/><Setter Property="Background" Value="#1B1E1C"/><Setter Property="BorderBrush" Value="#303632"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,7,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#232824"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#39B86E"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#131513"/><Setter Property="Foreground" Value="#EEF1EC"/><Setter Property="CaretBrush" Value="#39B86E"/><Setter Property="SelectionBrush" Value="#28543A"/><Setter Property="BorderBrush" Value="#303632"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EEF1EC"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem"><Setter Property="ToolTip" Value="Описание"/><Setter Property="ToolTipService.InitialShowDelay" Value="450"/><Setter Property="ToolTipService.ShowDuration" Value="60000"/><EventSetter Event="ToolTipOpening" Handler="ItemTip_Opening"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#233A2C"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#465048"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#171A18"/><Setter Property="Foreground" Value="#EEF1EC"/><Setter Property="BorderBrush" Value="#465048"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15"/><Setter Property="MaxWidth" Value="590"/><Setter Property="MaxHeight" Value="650"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="Background" Value="#1B1E1C"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton x:Name="Less" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#465048" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="More" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Less" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="More" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="Surface" Background="#131513" TextOptions.TextFormattingMode="Display" SizeChanged="Surface_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Background="#1B1E1C" BorderBrush="#303632" BorderThickness="0,0,0,1" Padding="23,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#233A2C" BorderBrush="#39B86E" BorderThickness="1" CornerRadius="11" Width="43" Height="43"><TextBlock Text="◇" FontSize="32" Foreground="#39B86E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="М А Л А Х И Т" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="МАСТЕРСКАЯ КВЕСТОВ" Foreground="#AAB2AA" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
    <TextBlock x:Name="Tagline" Grid.Column="1" Text="Код. Связи. История." Foreground="#AAB2AA" VerticalAlignment="Center" FontSize="14"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="HomeButton" Content="Карты" Click="Home_Click"/><Button x:Name="RelatedDataButton" Content="Данные БД" Click="RelatedData_Click" ToolTip="Связанные задания, брифинги и тексты"/><Button Content="Открыть…" Click="Open_Click" ToolTip="MOB, текст или проект · Ctrl+O"/><Button x:Name="FolderButton" Content="Папка MOB…" Click="Folder_Click"/><Button x:Name="CopiesButton" Content="Копии ▾" Click="Copies_Click" ToolTip="Сохранить отдельную копию. Исходный документ остаётся без изменений."><Button.ContextMenu><ContextMenu Style="{StaticResource CopiesMenu}"><MenuItem Style="{StaticResource CopiesItem}" Header="Сохранить копию MOB / текста…" Click="Export_Click" ToolTip="Отдельный игровой MOB или текст сценария. Не заменяет исходный файл."/><MenuItem Style="{StaticResource CopiesItem}" Header="Сохранить копию проекта Малахита…" Click="Save_Click" ToolTip="Рабочий файл .malachite для Малахита. Игра его не читает; исходный MOB не сохраняется."/></ContextMenu></Button.ContextMenu></Button><Button x:Name="SaveChangesButton" Content="Сохранить изменения" Click="SaveChanges_Click" ToolTip="Ctrl+S · Общее сохранение редактора БД, включая открытый MOB. Записывает изменения в исходные файлы с проверкой конфликтов и резервной копией." Background="#39B86E" BorderBrush="#465048"/></StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="EditorSurface" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="236" MinWidth="195"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="InspectorColumn" Width="325" MinWidth="265"/></Grid.ColumnDefinitions>
   <Border x:Name="SidebarPanel" Background="#0E100F" BorderBrush="#303632" BorderThickness="0,0,1,0" Padding="15,20,12,12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="ОБОЗРЕВАТЕЛЬ" Foreground="#AAB2AA" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="ProjectName" Text="Учебная цепочка" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,13"/></StackPanel>
     <TextBox Grid.Row="1" x:Name="SearchBox" ToolTip="Поиск скриптов, команд и GS-переменных" TextChanged="Search_Changed" Margin="0,0,0,10"/>
     <WrapPanel Grid.Row="2" Margin="0,0,0,9"><Button Content="Скрипты" Click="Scripts_Click" Padding="8,6"/><Button Content="Функции" Click="Functions_Click" Padding="8,6"/><Button Content="GS" Click="Flags_Click" Padding="8,6"/></WrapPanel>
     <ListBox Grid.Row="3" x:Name="Navigation" SelectionChanged="Navigation_Changed"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="12"/><TextBlock Text="{Binding Subtitle}" Foreground="#AAB2AA" FontSize="10" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <StackPanel Grid.Row="4" Margin="0,14,0,0"><Button Content="Инструменты скрипта…" Click="Workbench_Click" Margin="0,0,0,9"/><Button Content="Добавить шаблон…" Click="Templates_Click" Margin="0,0,0,9"/><Button Content="＋  Добавить скрипт" Click="AddStage_Click" Margin="0,0,0,9"/><Button Content="Новая цепочка" Click="New_Click" Background="#1B1E1C" Margin="0,0,0,10"/><TextBlock Text="Модуль Малахит · 0.4.0 · наведите мышь на имя" Style="{StaticResource Muted}"/></StackPanel>
    </Grid>
   </Border>
   <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#1B1E1C"/>
   <Grid x:Name="EditorArea" Grid.Column="2" Margin="18,19,18,0" SizeChanged="EditorArea_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="CodeRow" Height="*" MinHeight="180"/><RowDefinition Height="8"/><RowDefinition x:Name="DiagnosticsRow" Height="120" MinHeight="70"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="DocumentTabs" Orientation="Horizontal" Margin="0,0,0,8"/></ScrollViewer>
     <DockPanel Margin="0,0,0,8"><TextBlock x:Name="DocumentSummary" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBlock x:Name="DocumentTitle" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
     <WrapPanel><Button x:Name="SidebarToggle" Content="‹ Скрипты" Click="SidebarToggle_Click" Padding="8,5"/><Button Content="Квесты карты" Click="Atlas_Click" Padding="8,5"/><Button x:Name="CodeButton" Content="Код" Click="Code_Click" Padding="8,5"/><Button x:Name="InspectorToggle" Content="Объяснение ›" Click="InspectorToggle_Click" Padding="8,5"/></WrapPanel>
    </StackPanel>
    <Border x:Name="QuestAtlasPanel" VerticalAlignment="Top" LayoutUpdated="Atlas_LayoutUpdated" Visibility="Collapsed" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="10" Background="#1B1E1C" BorderBrush="#303632" BorderThickness="1" Padding="10">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top">
       <DockPanel><Button DockPanel.Dock="Right" Content="Вернуться к коду" Click="AtlasClose_Click"/><TextBlock Text="КВЕСТЫ КАРТЫ" Foreground="#39B86E" FontSize="17"/></DockPanel>
       <TextBlock x:Name="AtlasStatus" Margin="0,8" TextWrapping="Wrap"/>
       <CheckBox x:Name="AtlasIndirect" Content="Включить квесты через брифинги" IsChecked="False" Foreground="#EEF1EC" Margin="0,4,0,8" Checked="AtlasScope_Changed" Unchecked="AtlasScope_Changed"/>
      </StackPanel>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="230"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="180"/></Grid.ColumnDefinitions>
       <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,6,8"><TextBlock Text="Найти по названию или ключу" Foreground="#AAB2AA" FontSize="12" Margin="5,0,0,4"/><TextBox x:Name="AtlasSearch" TextChanged="AtlasSearch_Changed" ToolTip="Название квеста или полный GS-ключ"/></StackPanel>
        <Expander x:Name="AtlasOtherExpander" DockPanel.Dock="Bottom" IsExpanded="False" Foreground="#AAB2AA" Margin="0,8,0,0">
         <ListBox x:Name="AtlasOtherChecks" MaxHeight="220" ScrollViewer.CanContentScroll="False" SelectionChanged="AtlasSelection_Changed" ItemTemplate="{Binding ItemTemplate, ElementName=AtlasQuests}"/>
        </Expander>
        <ListBox x:Name="AtlasQuests" ScrollViewer.CanContentScroll="False" SelectionChanged="AtlasSelection_Changed">
         <ListBox.GroupStyle><GroupStyle HidesIfEmpty="True"><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#39B86E" TextWrapping="Wrap" Margin="6,12,6,6" FontWeight="SemiBold"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
         <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Key}" Foreground="#39B86E" FontSize="12" Margin="0,3,0,0"/><TextBlock Text="{Binding Reason}" Foreground="#AAB2AA" FontSize="12" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
       </DockPanel>
       <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#303632" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
       <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0"><StackPanel x:Name="AtlasNodes"/></ScrollViewer>
      </Grid>
     </DockPanel>
    </Border>
    <Border x:Name="CodeBorder" Grid.Row="1" Background="#131513" BorderBrush="#303632" BorderThickness="1" CornerRadius="7" Margin="0,10,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="3" x:Name="ArgumentHelp" Height="38" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#AAB2AA" Margin="12,5" FontSize="12" TextWrapping="Wrap" Text="Ctrl+Пробел — список команд · Enter/Tab — вставить · Esc — закрыть"/><Grid Margin="12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Поиск" Click="Find_Click" Padding="7,3" ToolTip="Ctrl+F"/><Button Content="Замена" Click="Replace_Click" Padding="7,3" ToolTip="Ctrl+H"/><Button Content="→" Click="Indent_Click" Padding="7,3" ToolTip="Увеличить отступ строк · Tab"/><Button Content="←" Click="Unindent_Click" Padding="7,3" ToolTip="Уменьшить отступ строк · Shift+Tab"/></StackPanel><TextBlock x:Name="CaretLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#39B86E" FontSize="11"/></Grid><StackPanel x:Name="FindPanel" Grid.Row="1" Visibility="Collapsed" Margin="10,3" PreviewKeyDown="Find_KeyDown"><DockPanel><Button DockPanel.Dock="Right" Content="×" Click="FindClose_Click" Padding="8,3"/><Button DockPanel.Dock="Right" Content="Следующее" Click="FindNext_Click" Padding="8,3"/><Button DockPanel.Dock="Right" Content="Предыдущее" Click="FindPrevious_Click" Padding="8,3"/><CheckBox x:Name="FindCase" DockPanel.Dock="Right" Content="Aa" Foreground="#EEF1EC" VerticalAlignment="Center" Margin="6,0" ToolTip="Учитывать регистр"/><TextBox x:Name="FindText" ToolTip="Найти в коде" Padding="6,3"/></DockPanel><DockPanel x:Name="ReplaceRow" Margin="0,4,0,0"><Button DockPanel.Dock="Right" Content="Заменить все" Click="ReplaceAll_Click" Padding="8,3"/><Button DockPanel.Dock="Right" Content="Заменить" Click="ReplaceOne_Click" Padding="8,3"/><TextBox x:Name="ReplaceText" ToolTip="Заменить на" Padding="6,3"/></DockPanel><TextBlock x:Name="FindResult" Foreground="#AAB2AA" FontSize="11"/></StackPanel><AdornerDecorator Grid.Row="2"><TextBox x:Name="CodeEditor" TextOptions.TextFormattingMode="Display" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="58,8,15,20" TextChanged="Code_Changed" SelectionChanged="Caret_Changed" SpellCheck.IsEnabled="False" TextWrapping="NoWrap" UndoLimit="100"/></AdornerDecorator></Grid></Border>
    <GridSplitter x:Name="DiagnosticsSplitter" Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#303632" Cursor="SizeNS" ToolTip="Потяните вверх или вниз, чтобы изменить высоту проверок"/>
    <Grid Grid.Row="3" SizeChanged="DiagnosticsPanel_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,6,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="ChecksToggle" Content="Проверки ▾" Click="ChecksToggle_Click" Padding="6,3"/><TextBlock x:Name="CheckSummary" Text="ПРОВЕРКА КОДА" Foreground="#AAB2AA" FontSize="10" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" Content="Проверить · F5" Click="Check_Click" Padding="9,5"/></Grid>
    <ListBox Grid.Row="1" x:Name="Diagnostics" SelectionChanged="Diagnostic_Changed" FontSize="11"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="11"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
   </Grid>
   <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#1B1E1C"/>
   <Border x:Name="InspectorPanel" Grid.Column="4" Background="#0E100F" BorderBrush="#303632" BorderThickness="1,0,0,0" Padding="18,22,18,14">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="ИНСПЕКТОР" Foreground="#AAB2AA" FontSize="10"/><TextBlock x:Name="InspectorTitle" Text="Скрипт" FontSize="20" FontWeight="SemiBold" Margin="0,11,0,7"/><TextBlock x:Name="InspectorHint" Text="Выберите скрипт или действие." Style="{StaticResource Muted}" Margin="0,0,0,17"/>
     <ContentControl x:Name="ExplanationContent" Margin="0,0,0,14"/>
     <WrapPanel Margin="0,0,0,12"><Button Content="＋ Добавить действие" Click="AddAction_Click" Padding="9,6"/><Button Content="Шаблон…" Click="Templates_Click" Padding="9,6"/></WrapPanel>
     <StackPanel x:Name="CardPanel"><Expander Header="Изменить условия и ветку" Foreground="#EEF1EC" IsExpanded="False"><StackPanel Margin="0,10,0,0">
      <TextBlock Text="УСЛОВИЯ ЗАПУСКА" Foreground="#39B86E" FontSize="10" Margin="0,0,0,7"/><TextBox x:Name="ConditionBox" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78" MaxHeight="185" VerticalScrollBarVisibility="Auto" TextChanged="Card_Changed"/>
      <TextBlock Text="ДЕЙСТВИЯ · THEN" Foreground="#39B86E" FontSize="10" Margin="0,17,0,7"/><TextBox x:Name="ActionBox" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="260" VerticalScrollBarVisibility="Auto" TextChanged="Card_Changed"/>
      <StackPanel x:Name="ElsePanel"><CheckBox x:Name="UseElse" Content="Использовать else" Foreground="#C9AC77" Margin="0,12,0,0" Checked="Else_Changed" Unchecked="Else_Changed" ToolTip="Добавляет или удаляет else, включая пустую ветку. Условие выбирает одну ветку при достижении."/><TextBlock Text="ИНАЧЕ · ELSE" Foreground="#C9AC77" FontSize="10" Margin="0,17,0,7"/><TextBox x:Name="ElseBox" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160" VerticalScrollBarVisibility="Auto" TextChanged="Card_Changed"/></StackPanel>
      <Button x:Name="ApplyCardButton" Content="Применить карточку к коду" Click="ApplyCard_Click" Margin="0,12,0,0" Background="#39B86E"/>
      <TextBlock Text="ЗАПУСТИТЬ ДРУГОЙ SCRIPT" Foreground="#39B86E" FontSize="10" Margin="0,20,0,7"/>
      <ListBox x:Name="LinkTargets" Height="85" BorderBrush="#303632" BorderThickness="1" Padding="3" FontSize="12"/>
      <Button Content="＋ Добавить вызов" Click="Link_Click" Margin="0,9,0,0"/><TextBlock Text="Вызов запускает экземпляр, а не ждёт завершения этапа." Style="{StaticResource Muted}" Margin="0,9,0,0"/>
     </StackPanel></Expander></StackPanel>
     <StackPanel x:Name="HelpPanel" Visibility="Collapsed"><Border Background="#1B1E1C" BorderBrush="#303632" BorderThickness="1" CornerRadius="6" Padding="12"><TextBlock x:Name="SignatureText" FontFamily="Consolas" FontSize="13" Foreground="#39B86E"/></Border><TextBlock x:Name="HelpText" Margin="0,17,0,0" LineHeight="21"/><TextBlock x:Name="HelpProvenance" Foreground="#AAB2AA" FontSize="11" Margin="0,18,0,12"/><TextBlock Text="ИСПОЛЬЗОВАНИЯ В ДОКУМЕНТЕ" Foreground="#39B86E" FontSize="10"/><ListBox x:Name="UsageList" MaxHeight="230" SelectionChanged="Usage_Changed" Margin="0,10,0,0"/></StackPanel>
     <Border BorderBrush="#303632" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,15,0,0"><TextBlock Text="Проверка здесь — статическая. Компиляция движком и проверка в игре выполняются отдельно." Style="{StaticResource Muted}"/></Border>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Grid x:Name="HomePanel" Grid.Row="1" Background="#131513" Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button x:Name="HomeResume" DockPanel.Dock="Right" Content="Вернуться к открытому сценарию" Click="HomeResume_Click" Visibility="Collapsed"/><StackPanel><TextBlock Text="Выберите карту" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Откройте MOB, чтобы работать с его скриптами и квестами." Foreground="#AAB2AA" Margin="0,8,0,0"/></StackPanel></DockPanel>
   <DockPanel Grid.Row="1" Margin="0,12,0,8"><TextBlock Text="Поиск карты" VerticalAlignment="Center" Foreground="#AAB2AA" Margin="0,0,14,0"/><TextBox x:Name="HomeSearch" TextChanged="HomeSearch_Changed" ToolTip="Поиск карты по имени · Ctrl+F"/></DockPanel>
   <StackPanel Grid.Row="2" Margin="0,0,0,8"><WrapPanel Margin="0,0,0,8"><Button x:Name="HomeAll" Tag="all" Content="Все карты" Click="HomeFilter_Click" Padding="10,5"/><Button x:Name="HomeRecent" Tag="recent" Content="Недавние" Click="HomeFilter_Click" Padding="10,5"/><Button x:Name="HomeFavorites" Tag="favorites" Content="★ Избранные" Click="HomeFilter_Click" Padding="10,5"/><TextBlock Text="Сортировка:" Foreground="#AAB2AA" VerticalAlignment="Center" Margin="8,0"/><Button x:Name="HomeSortName" Content="По имени ↑" Click="HomeSortName_Click" Padding="10,5" ToolTip="Повторное нажатие меняет направление."/><Button x:Name="HomeSortDate" Content="По дате" Click="HomeSortDate_Click" Padding="10,5" ToolTip="Повторное нажатие меняет направление."/></WrapPanel><TextBlock x:Name="HomeStatus" Foreground="#AAB2AA"/></StackPanel>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="HomeDetailsColumn" Width="280"/></Grid.ColumnDefinitions>
   <ListBox x:Name="HomeMaps" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HomeSelection_Changed" MouseDoubleClick="HomeMaps_Open" KeyDown="HomeMaps_KeyDown">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="250" ItemHeight="98"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Width" Value="240"/><Setter Property="Height" Value="88"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Padding" Value="12,10"/><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="#1B1E1C" BorderBrush="#303632" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#39B86E"/><Setter TargetName="Tile" Property="Background" Value="#232824"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#233A2C"/><Setter TargetName="Tile" Property="BorderBrush" Value="#39B86E"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#39B86E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding FavoriteMark}" Foreground="#39B86E" Margin="5,0,0,0"/><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/></DockPanel><TextBlock Grid.Row="1" Text="{Binding Facts}" FontSize="10" Foreground="#AAB2AA"/><TextBlock Grid.Row="2" FontSize="10" Foreground="#AAB2AA" Margin="0,3,0,0" TextWrapping="NoWrap"><Run Text="Изменён: "/><Run Text="{Binding Modified, Mode=OneWay}"/></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border x:Name="HomeMapDetails" Grid.Column="1" Background="#1B1E1C" BorderBrush="#303632" BorderThickness="1" CornerRadius="7" Padding="16" Margin="12,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="HomeMapName" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="HomeMapPath" Foreground="#AAB2AA" FontSize="11" Margin="0,8,0,16"/><TextBlock Text="Последнее изменение" Style="{StaticResource Muted}"/><TextBlock x:Name="HomeMapModified" Margin="0,4,0,12"/><TextBlock Text="Скриптов" Style="{StaticResource Muted}"/><TextBlock x:Name="HomeMapScripts" Margin="0,4,0,12"/><TextBlock Text="Объектов MOB" Style="{StaticResource Muted}"/><TextBlock x:Name="HomeMapObjects" Margin="0,4,0,16"/><Button x:Name="HomeFavorite" Content="☆ В избранное" Click="HomeFavorite_Click" HorizontalAlignment="Left"/><TextBlock Text="Моя заметка" Margin="0,20,0,6"/><TextBox x:Name="HomeNote" MaxLength="500" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="HomeNote_Changed" LostKeyboardFocus="HomeNote_LostFocus"/><TextBlock Text="Заметка сохраняется при выходе из поля. MOB не изменяется." Style="{StaticResource Muted}" Margin="0,6,0,8"/><Button Content="Сохранить заметку" Click="HomeNoteSave_Click" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></Border></Grid>
   <WrapPanel Grid.Row="4" Margin="0,10,0,0"><Button x:Name="HomeOpen" Content="Открыть выбранную карту" Click="HomeMaps_Open" Background="#39B86E"/><Button Content="Открыть файл…" Click="Open_Click"/><Button Content="Выбрать папку MOB…" Click="Folder_Click"/><Button Content="Новая цепочка" Click="New_Click"/></WrapPanel>
  </Grid>
  <Border Grid.Row="2" Background="#233A2C" Padding="16,0"><Grid><TextBlock x:Name="StatusText" Text="Готово" FontSize="11" VerticalAlignment="Center" Foreground="#AAB2AA"/><TextBlock x:Name="EncodingText" Text="UTF-8 · локальный проект" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#AAB2AA"/></Grid></Border>
 </Grid>
 
</UserControl>
